{
  "schema_version": "1.0",
  "run_name": "xai4heat_external_baselines_v1",
  "experiment": "Frozen five-seed power-history baselines on XAI4HEAT",
  "dataset": {
    "loader": "xai4heat",
    "path": "data/xai4heat_scada_2024_generic_v1.npz",
    "sha256": null,
    "source_zip_sha256": "4cee8313fa7c66cdff3e6e928ce28a53f205a06b91c79e215bcd6ec6be618aed",
    "history_steps": 60,
    "horizon_steps": 15,
    "target": "five-unit training-standardized mean heat demand over next 15 hours"
  },
  "seeds": [42, 43, 44, 45, 46],
  "models": [
    "dlinear_power", "fouriergnn_power_official_small",
    "itransformer_power", "softs_power_compact", "timemixer_power"
  ],
  "model": {
    "moving_average_kernel": 25,
    "d_model": 64, "n_heads": 4, "layers": 2,
    "feedforward_size": 128, "dropout": 0.1,
    "softs": {
      "softs_power_compact": {
        "d_model": 128, "d_core": 32, "layers": 3,
        "feedforward_size": 128, "dropout": 0.1
      }
    },
    "fouriergnn": {
      "fouriergnn_power_official_small": {
        "embed_size": 256, "hidden_size": 512, "sparsity_threshold": 0.01
      }
    },
    "timemixer": {
      "d_model": 64, "d_ff": 128, "layers": 2,
      "down_sampling_layers": 3, "down_sampling_window": 2,
      "moving_average_kernel": 25, "dropout": 0.1,
      "channel_independence": true, "prediction_length": 1
    }
  },
  "data_loading": {
    "train_windows": 3543, "validation_windows": 3543,
    "holdout_windows": 3492, "batch_size": 64,
    "num_workers": 4, "log_every_batches": 20
  },
  "training_by_mode": {
    "dlinear_power": {
      "epochs": 12, "minimum_epochs": 6, "early_stopping_patience": 3,
      "optimizer": "adamw", "learning_rate": 0.001,
      "weight_decay": 0.0001, "gradient_clip_norm": 1.0
    },
    "itransformer_power": {
      "epochs": 12, "minimum_epochs": 6, "early_stopping_patience": 3,
      "optimizer": "adamw", "learning_rate": 0.001,
      "weight_decay": 0.0001, "gradient_clip_norm": 1.0
    },
    "softs_power_compact": {
      "epochs": 20, "minimum_epochs": 6, "early_stopping_patience": 4,
      "optimizer": "adamw", "learning_rate": 0.0003,
      "weight_decay": 0.0001, "gradient_clip_norm": 1.0
    },
    "fouriergnn_power_official_small": {
      "epochs": 50, "minimum_epochs": 10, "early_stopping_patience": 8,
      "optimizer": "rmsprop", "learning_rate": 0.00001,
      "weight_decay": 0.0, "scheduler_step_epochs": 5,
      "scheduler_gamma": 0.5, "gradient_clip_norm": 1.0
    },
    "timemixer_power": {
      "epochs": 20, "minimum_epochs": 6, "early_stopping_patience": 4,
      "optimizer": "adamw", "learning_rate": 0.001,
      "weight_decay": 0.0001, "gradient_clip_norm": 1.0
    }
  },
  "selection": {
    "criterion": "lowest joint standardized validation MSE per seed",
    "input_protocol": "power history only",
    "hyperparameter_search": false,
    "holdout_policy": "separate frozen evaluator after validation"
  }
}
