  "protocol": {
    "frozen_after_full_admission": true,
    "normal_files_only": true,
    "causal_imputation": "forward fill within each source file then training median",
    "normalization": "training files only per named variable and per target",
    "window_boundary": "no window may cross a source-file boundary",
    "holdout_model_evaluated_during_preparation": false,
    "coordinate_xy_semantics": "functional layout only, not geographical distance"
