      "A2_conversion": ["P2_SIT01", "P2_SCST", "P2_SCO", "P4_ST_GOV", "P4_ST_PT01", "P4_ST_TT01"],
      "A3_generation": ["P4_ST_LD", "P4_ST_PS", "P4_ST_FD", "P4_LD", "P4_ST_PO", null],
      "A4_auxiliary": ["P1_PP04", "P1_PP04SP", "P1_TIT03", "P1_FT03Z", null, null]
